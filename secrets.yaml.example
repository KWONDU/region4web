# Copy this file to secrets.yaml and fill in your own keys.
# secrets.yaml is read by benchmarks.runner at startup (see config.yaml's
# `secrets_file` field) and the values are exported as environment variables
# (OPENAI_API_KEY, ANTHROPIC_API_KEY, HF_TOKEN) before any LLM call.

openai_api_key:        ""   # https://platform.openai.com/api-keys
anthropic_api_key:     ""   # https://console.anthropic.com/settings/keys
deepseek_api_key:      ""   # https://platform.deepseek.com/api_keys
gemini_api_key:        ""   # https://aistudio.google.com/app/apikey
huggingface_api_key:   ""   # https://huggingface.co/settings/tokens
